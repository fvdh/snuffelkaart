---
// Gewone tekstpagina's (privacy, hoe we controleren): statisch, vindbaar, zelfde stijl als de app.
import '../styles/design.css';
import Sprite from '../components/Sprite.astro';
import Meten from '../components/Meten.astro';
import Deel from '../components/Deel.astro';
import { SITE } from '../lib/sitedata';
const { title, description, wide = false } = Astro.props;
const canonical = SITE + Astro.url.pathname;
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · Snuffelkaart</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <Deel title={title} description={description} url={canonical} />
    <Meten />
    <slot name="head" />
    <style is:global>
      body { background: var(--bg); color: var(--fg); font-family: var(--font); margin: 0 }
      .tp.wide { max-width: 880px }
      .tp-crumbs { font-size: .8125rem; color: var(--fg-3) } .tp-crumbs a { color: var(--fg-2); font-weight: 500 }
      .tp .rows { list-style: none; margin: 0; padding: 0 } .tp .row { text-decoration: none; color: inherit } .tp .r-meta { white-space: normal }
      .tp-cta { display: flex; flex-direction: column; gap: 10px; padding: 16px; border-radius: 14px; background: var(--surface-2); margin-top: 18px } .tp-cta .btn { align-self: flex-start; text-decoration: none }
      .tp-now { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; font-size: .9375rem; margin: 0 } .tp-now::before { content: ''; width: 9px; height: 9px; border-radius: 50% } .tp-now.open { color: var(--open-ink) } .tp-now.open::before { background: var(--open) } .tp-now.closed { color: var(--fg-2) } .tp-now.closed::before { background: var(--fg-3) }
      .tp-weekend { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px } .tp-weekend h3 { font-size: 1rem; font-weight: 700; margin: 0 0 8px } .tp-weekend li { line-height: 1.4 }
      .tp-hours .vandaag { color: var(--fg); font-weight: 700 }
      .tp-filter { margin-top: 14px } .tp-filter input { font: inherit }
      .tp-hours { display: grid; grid-template-columns: auto 1fr; gap: 4px 18px; margin: 0; font-variant-numeric: tabular-nums } .tp-hours dt { color: var(--fg-2) } .tp-hours dd { margin: 0 }
      .tp-links { display: flex; flex-wrap: wrap; gap: 6px 14px; list-style: none; padding: 0 !important; margin: 0 }
      .tp h1.strike { text-decoration: line-through; text-decoration-color: var(--bad); text-decoration-thickness: 2px }
      .tp-letter { font-size: .8125rem; font-weight: 700; color: var(--fg-3); margin-top: 14px }
      .tp { max-width: 680px; margin: 0 auto; padding: 20px 16px 72px }
      .tp-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 20px }
      .tp-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 750; color: var(--fg); text-decoration: none }
      .tp-mark { width: 30px; height: 30px; border-radius: 9px; background: var(--ink); color: var(--on-ink); display: grid; place-items: center }
      .tp-back { color: var(--fg-2); font-weight: 600; text-decoration: none; font-size: .9375rem }
      .tp h1 { font-size: clamp(1.75rem, 5vw, 2.25rem); font-weight: 750; letter-spacing: -.02em; line-height: 1.1; margin: 8px 0 12px }
      .tp .lede { color: var(--fg-2); font-size: 1.0625rem; max-width: 60ch }
      .tp h2 { font-size: 1.125rem; font-weight: 700; margin: 0 }
      .tp section { padding: 22px 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; margin-top: 22px }
      .tp section + section { margin-top: 0 }
      .tp p, .tp li { color: var(--fg-2); line-height: 1.55 }
      .tp ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px }
      .tp a { color: var(--fg); font-weight: 600 }
      .tp b { color: var(--fg) }
      .legend { list-style: none; margin: 0; padding: 0 !important; gap: 0 !important }
      .legend li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; align-items: start; padding: 12px 0; border-bottom: 1px solid var(--line) }
      .legend .pin { position: relative; margin: 4px 0 0 4px; display: block }
      .legend b { display: block; font-size: .9375rem }
      .legend p { font-size: .9375rem; margin: 2px 0 0 }
      .srclist { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px }
      .srclist dt { font-weight: 650; margin-top: 10px }
      .srclist dd { margin: 0; color: var(--fg-2) }
      .tp-foot { margin-top: 32px; font-size: .875rem; color: var(--fg-3); display: flex; gap: 16px; flex-wrap: wrap }
      .tp-foot a { color: var(--fg-2); font-weight: 500 }
    </style>
  </head>
  <body>
    <Sprite />
    <main class={`tp${wide ? ' wide' : ''}`}>
      <div class="tp-top"><a class="tp-brand" href="/"><span class="tp-mark"><svg class="i" aria-hidden="true"><use href="#i-tag" /></svg></span>Snuffelkaart</a><a class="tp-back" href="/">Naar de kaart</a></div>
      <slot />
      <footer class="tp-foot"><a href="/plaatsen/">Alle plaatsen</a><a href="/hoe-we-controleren">Hoe we controleren</a><a href="/privacy">Privacy</a><a href="/voorwaarden">Voorwaarden</a><a href="/colofon">Colofon</a><a href="/data/places.json">Open data (ODbL)</a></footer>
    </main>
  </body>
</html>
