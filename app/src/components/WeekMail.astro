---
// Aanmelden voor de weekendmail op statische pagina's (plaats, winkel, markt, marktlijsten): zelfde formulier als op de homepage
// (worker/mail.js), compact, met de plaats van de pagina al ingevuld. `via` = deze pagina, zodat we zien welke pagina's aanmeldingen opleveren.
interface Props { plek?: string | null }
const { plek } = Astro.props;
const id = 'wm';
---
<form class="wm" method="post" action="/api/aanmelden" aria-labelledby={`${id}-kop`}>
  <span class="wm-zegel" aria-hidden="true"><svg class="i"><use href="#i-mail" /></svg></span>
  <h2 id={`${id}-kop`}>{plek ? `Elke donderdag de markten rond ${plek}` : 'Elke donderdag de markten bij jou in de buurt'}</h2>
  <p class="wm-tekst">Een korte mail met de rommelmarkten van het weekend, binnen de afstand die je kiest. Geen markten in de buurt, dan geen mail.</p>
  <input type="hidden" name="lijst" value="weekend" />
  <input type="hidden" name="via" value={Astro.url.pathname} />
  <div class="wm-velden">
    <label for={`${id}-mail`} style="grid-area:l1">Je e-mailadres</label>
    <input id={`${id}-mail`} name="email" type="email" autocomplete="email" required style="grid-area:i1" />
    <label for={`${id}-plek`} style="grid-area:l2">Plaats of postcode</label>
    <input id={`${id}-plek`} name="plek" required autocomplete="address-level2" value={plek ?? ''} placeholder="Haarlem" style="grid-area:i2" />
    <label for={`${id}-km`} style="grid-area:l3">Afstand</label>
    <select id={`${id}-km`} name="km" style="grid-area:i3"><option value="10">10 km</option><option value="25" selected>25 km</option><option value="50">50 km</option></select>
    <button type="submit" style="grid-area:b">Aanmelden</button>
  </div>
  <p class="wm-hint">Eerst krijg je een mail om te bevestigen. Afmelden kan met één klik. <a href="/privacy/#mail">Wat we bewaren</a></p>
  <div class="wm-hp" aria-hidden="true"><label>Laat dit leeg <input name="website" tabindex="-1" autocomplete="off" /></label></div>
</form>
<style>
  /* Zelfde taal als de band op de homepage (home.css .post): donker, gele knop, postzegel. */
  .wm { position: relative; margin: 32px 0 8px; padding: 22px 20px 18px; border-radius: 16px; background: var(--ink); color: var(--on-ink) }
  .wm h2 { margin: 0; padding-right: 64px; font-size: 1.25rem; line-height: 1.2; font-weight: 740; letter-spacing: -.015em; text-wrap: balance }
  .wm-tekst { margin: 8px 0 0; padding-right: 64px; font-size: .9375rem; color: color-mix(in oklch, var(--on-ink) 82%, var(--ink)) }
  .wm-zegel { position: absolute; top: 18px; right: 18px; width: 44px; height: 52px; display: grid; place-items: center; background: var(--markt); color: var(--on-markt); border-radius: 3px; outline: 2px dashed var(--ink); outline-offset: -5px; transform: rotate(5deg) }
  .wm-zegel .i { width: 22px; height: 22px }
  .wm-velden { margin-top: 16px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "l1 l2" "i1 i2" "l3 ." "i3 b"; gap: 6px 10px; align-items: end }
  @media (max-width: 520px) { .wm-velden { grid-template-areas: "l1 l1" "i1 i1" "l2 l2" "i2 i2" "l3 ." "i3 b" } }
  .wm label { font-weight: 600; font-size: .875rem }
  .wm-velden label[for$="-km"] { margin-top: 6px }
  .wm input, .wm select { box-sizing: border-box; height: 48px; width: 100%; margin: 0; padding: 0 12px; border: 0; border-radius: 11px; background: var(--on-ink); color: var(--ink); font: 500 1rem var(--font) }
  .wm input::placeholder { color: color-mix(in oklch, var(--ink) 55%, var(--on-ink)) }
  .wm button { height: 48px; border: 0; border-radius: 11px; background: var(--markt); color: var(--on-markt); font: 700 1rem var(--font); cursor: pointer }
  .wm :focus-visible { outline: 2px solid var(--on-ink); outline-offset: 3px }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .wm button { background: var(--on-ink); color: var(--markt) } }
  :root[data-theme="dark"] .wm button { background: var(--on-ink); color: var(--markt) }
  .wm-hint { margin: 12px 0 0; font-size: .8125rem; color: color-mix(in oklch, var(--on-ink) 78%, var(--ink)) }
  .wm-hint a { color: var(--on-ink) }
  .wm-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden }
</style>
