---
import '../styles/design.css';
import '../styles/app.css';
import 'maplibre-gl/dist/maplibre-gl.css';
import App from '../components/App.tsx';
import Sprite from '../components/Sprite.astro';
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f6f3" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Snuffelkaart" />
    <script>
      // Offline (public/sw.js), alleen in de gebouwde site: in dev zit de service worker Vite in de weg.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    </script>
    <title>Snuffelkaart</title>
    <meta name="description" content="Kringlopen en rommelmarkten op één kaart. Zie wat er nu open is en plan je zaterdag." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400..800&family=DM+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <Sprite />
    <App client:only="react" />
  </body>
</html>
