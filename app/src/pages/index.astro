---
import '../styles/design.css';
import '../styles/app.css';
import 'maplibre-gl/dist/maplibre-gl.css';
import App from '../components/App.tsx';
import Deel from '../components/Deel.astro';
import { SITE } from '../lib/sitedata';
import Sprite from '../components/Sprite.astro';
import Meten from '../components/Meten.astro';
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f6f3" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Snuffelkaart" />
    <script>
      // Offline (public/sw.js), alleen in de gebouwde site: in dev zit de service worker Vite in de weg.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    </script>
    <Meten />
    <title>Snuffelkaart · Kringlopen en rommelmarkten bij jou in de buurt</title>
    <meta name="description" content="Kringlopen en rommelmarkten op één kaart. Zie wat er nu open is en plan je zaterdag." />
    <meta name="msvalidate.01" content="1B8302EE3C0F80DEB2AD0692CF65CA49" /><!-- Bing Webmaster Tools -->
    <Deel title="Snuffelkaart" description="Kringlopen en rommelmarkten op één kaart. Zie wat er nu open is en plan je zaterdag." url={SITE + '/'} />
  </head>
  <body>
    <Sprite />
    <h1 class="sr-only">Kringlopen en rommelmarkten bij jou in de buurt</h1>
    <App client:only="react" />
  </body>
</html>
