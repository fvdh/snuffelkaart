---
// Winkelpagina (ontwerp "deurbordje", 9 nov): bovenaan als tekst wat een zoeker wil weten (open nu, de hele week, adres, telefoon),
// dan de kaart als ingang naar de app, dan tijden per dag, reviews, wat er in de buurt zaterdag open is en markten.
import Tekst from '../../layouts/Tekst.astro';
import ItemRow from '../../components/ItemRow.astro';
import KaartBlok from '../../components/KaartBlok.astro';
import PlekDock from '../../components/PlekDock.astro';
import '../../styles/plek.css';
import type { Place } from '../../lib/model';
import { catOf, km, dLong, DAYS_LONG, hm, cap } from '../../lib/model';
import { near, thin, weekIntervals, hoursSpec, hoursSummary, fmtTel, splitAddr, niceVenue } from '../../lib/seo';
import { CAT } from '../../components/ui';
import { ix, places, markets, from, holidays, extra, SITE } from '../../lib/sitedata';
import { avg } from '../../lib/bijdragen';
import { DAY_CATS } from '../../lib/plan';

export function getStaticPaths() {
  return [...ix.shops].map(([slug, p]) => ({ params: { slug }, props: { p } }));
}
const { p } = Astro.props as { p: Place };
const c = catOf(p), sort = c === 'kringloop' ? 'Kringloopwinkel' : CAT[c][0], wk = weekIntervals(p.h, from, holidays), cityUrl = ix.cityUrl(p.place);
const ivTxt = (iv: [number, number][]) => (iv.length ? iv.map(([a, b]) => `${hm(a)}–${hm(b % 1440)}`).join(' en ') : 'dicht');
const web = p.website ? (p.website.startsWith('http') ? p.website : `https://${p.website}`) : null;
const webTxt = p.website?.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const tel = p.phone?.split(';')[0].trim(), telTxt = tel && fmtTel(tel), telHref = tel?.replace(/[^\d+]/g, '');
const { street, pc, town } = splitAddr(p.addr, p.place);
const osm = /^osm-([nwr])(\d+)$/.exec(p.id), osmUrl = osm ? `https://www.openstreetmap.org/${{ n: 'node', w: 'way', r: 'relation' }[osm[1] as 'n' | 'w' | 'r']}/${osm[2]}` : null;
const mk = near(p, markets, from, 10, 4);
const route = `https://www.google.com/maps/dir/?api=1&destination=${p.lat.toFixed(5)},${p.lon.toFixed(5)}`; // iPhone opent dit ook netjes
const kaart = `/kaart/?open=${encodeURIComponent(p.id)}`;
const checked = p.checked ? dLong(p.checked).toLowerCase() : null;
// Buren: zelfde naam maar één keer (twee vestigingen), geen sloop of pandjeshuis; dichtstbij eerst.
const seenName = new Set([p.name.toLowerCase()]);
const others = places.filter(o => o !== p && km(p, o) < 5 && DAY_CATS.includes(catOf(o))).sort((a, b) => km(p, a) - km(p, b))
  .filter(o => !seenName.has(o.name.toLowerCase()) && seenName.add(o.name.toLowerCase())).slice(0, 12);
const satOf = (o: Place) => weekIntervals(o.h, from, holidays)?.find(d => d.wd === 6)?.iv ?? [];
const sat = others.filter(o => km(p, o) < 2.5 && satOf(o).length).slice(0, 5);
const kmTxt = (k: number) => (k < 1 ? `${Math.max(50, Math.round(k * 20) * 50)} m` : `${k.toFixed(1).replace('.', ',')} km`);
const reviews = extra.reviews[p.id] ?? [], photos = extra.photos[p.id] ?? [], rating = avg(reviews);
const MONTHS = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
const url = ix.url(p.id), title = `${p.name}${p.place ? `, ${p.place}` : ''}: openingstijden en adres`;
const summary = wk && hoursSummary(wk);
const description = `${sort}${p.place ? ` in ${p.place}` : ''}${p.addr ? `, ${street}` : ''}. ` + (summary ? `Open ${summary}.` : p.dicht ? 'Volgens de eigen website tijdelijk gesloten.' : p.afspraak ? 'Alleen op afspraak.' : p.meld?.k === 'onregelmatig' ? `Niet elke week open: ${p.meld.q.slice(0, 80)}` : 'Openingstijden nog onbekend; bel even voordat je gaat.') + (telTxt ? ` Telefoon ${telTxt}.` : '');
const crumbs: [string, string][] = [['Snuffelkaart', '/'], ...(cityUrl ? [[p.place!, cityUrl] as [string, string]] : []), [p.name, url]];
const ld = { '@context': 'https://schema.org', '@type': 'Store', name: p.name, url: SITE + url, geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lon },
  ...(p.addr ? { address: { '@type': 'PostalAddress', streetAddress: street, ...(pc ? { postalCode: pc } : {}), addressLocality: town ?? undefined, addressCountry: 'NL' } } : {}), ...(tel ? { telephone: telTxt } : {}), ...(web ? { sameAs: web } : {}), ...(wk ? { openingHoursSpecification: hoursSpec(wk) } : {}),
  ...(reviews.length ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating, reviewCount: reviews.length, bestRating: 5, worstRating: 1 } } : {}),
  ...(photos.length ? { image: photos.slice(0, 3).map(f => f.url) } : {}) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE + u })) };
const fmtDate = (iso: string) => `${dLong(iso)}${iso.slice(0, 4) !== from.slice(0, 4) ? ` ${iso.slice(0, 4)}` : ''}`;
---
<Tekst title={title} description={description} tel={p.id} mail={p.place ?? true} wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbLd)} />
  {thin(p) && <meta name="robots" content="noindex, follow" slot="head" />}
  <nav aria-label="Kruimelpad"><ol class="pl-crumbs">{crumbs.map(([n, u], i) => i < crumbs.length - 1 ? <li><a href={u}>{n}</a></li> : <li aria-current="page">{n}</li>)}</ol></nav>

  <div class="pl-sign">
    <h1>{p.name}</h1>
    <p class="pl-what"><span class={`pl-shape c-${c}`} aria-hidden="true"></span>{sort}{p.place && ` in ${p.place}`}</p>
    <div class="pl-door">
      {p.h && <p class="pl-now" id="pl-nu" data-from={from} data-h={JSON.stringify(p.h.slice(0, 14))} hidden></p>}
      {summary ? <p class="pl-week">{summary}</p>
        : p.dicht ? <p class="pl-week bad">{p.dichtTot ? `Gesloten tot en met ${dLong(p.dichtTot).toLowerCase()}` : 'Tijdelijk gesloten'}, volgens de eigen website.</p>
        : p.afspraak ? <p class="pl-week unk">Geen vaste openingstijden: <em>alleen op afspraak</em>.</p>
        : p.meld?.k === 'onregelmatig' ? <p class="pl-week unk"><em>Niet elke week open.</em> Kijk op hun website of bel even.</p>
        : <p class="pl-week unk">Openingstijden <em>onbekend</em>. Bel even voordat je gaat.</p>}
    </div>
    <dl class="pl-facts">
      <div><dt>Adres</dt><dd>{street ?? p.place}{(pc || town) && street && <small>{[pc, town].filter(Boolean).join(' ')}</small>}</dd></div>
      {tel && <div><dt>Telefoon</dt><dd><a class="pl-big" href={`tel:${telHref}`}>{telTxt}</a></dd></div>}
      {web ? <div><dt>Website</dt><dd><a href={web} rel="nofollow">{webTxt}</a></dd></div>
        : p.fb && <div><dt>Facebook</dt><dd><a href={`https://www.facebook.com/${p.fb}`} rel="nofollow">Op Facebook</a></dd></div>}
    </dl>
    <div class="pl-acts">
      <a class="btn primary" href={kaart}><svg class="i" aria-hidden="true"><use href="#i-map" /></svg>Bekijk op de kaart</a>
      {tel && <a class="btn" href={`tel:${telHref}`}><svg class="i" aria-hidden="true"><use href="#i-phone" /></svg>Bel</a>}
      <a class="btn" href={route} rel="nofollow"><svg class="i" aria-hidden="true"><use href="#i-route" /></svg>Route</a>
    </div>
    <p class="pl-src">{p.hs === 'bezoeker' ? `Tijden doorgegeven door ${p.hb} en door ons nagekeken` : p.hs === 'web' ? <>Tijden van <a href={p.hu} rel="nofollow">de website van de winkel</a></> : p.h ? `Tijden uit ${p.src === 'osm' ? 'OpenStreetMap' : 'Overture Maps'}` : `Deze winkel komt uit ${p.src === 'osm' ? 'OpenStreetMap' : 'een open kaartbron (Overture Maps)'} en is nog niet door ons bekeken`}{checked ? `, gecontroleerd op ${checked}` : ''}.{p.h && ' Rond feestdagen kan het afwijken.'}{p.kind === 'tweedehands' && ' Geen standaard kringloop: eigen aanbod en eigen prijzen.'}</p>
  </div>

  <KaartBlok items={[p, ...mk, ...others]} hl={p.id} href={kaart} label={`${others.length + mk.length} plekken in de buurt op de kaart`} />

  <div class="pl-two">
    <section aria-labelledby="h-tijden">
      <h2 class="pl-h" id="h-tijden">Openingstijden {p.name}</h2>
      {wk ? <table class="pl-hours"><caption class="sr">Openingstijden in een gewone week</caption><tbody>{wk.map(({ wd, iv }) => <tr data-wd={wd}><th scope="row">{cap(DAYS_LONG[wd])}</th><td>{ivTxt(iv)}</td></tr>)}</tbody></table>
        : <>
          {(p.dicht || p.afspraak) && p.hq && <p class="pl-quote">“{p.hq}”</p>}
          {p.meld?.k === 'onregelmatig' && <p class="pl-quote">“{p.meld.q}”</p>}
          {(p.dicht || p.afspraak || p.meld?.k === 'onregelmatig') && <p class="pl-src">Letterlijk van <a href={p.meld?.u ?? p.hu} rel="nofollow">de website van de winkel</a>, gelezen op {dLong(p.dicht ?? p.afspraak ?? p.meld!.d).toLowerCase()}.</p>}
          {!p.dicht && !p.afspraak && <p>Ben je er geweest en weet je wanneer hij open is? <a href={`${kaart}&tijden=1`} rel="nofollow">Geef de tijden door</a>; wij kijken ze na.</p>}
        </>}
    </section>
    <section aria-labelledby="h-rev">
      <h2 class="pl-h" id="h-rev">{reviews.length ? `Reviews · ${String(rating).replace('.', ',')} van 5 (${reviews.length})` : 'Reviews'}</h2>
      {reviews.length ? <>
        {reviews.map(r => <div class="rev"><span class="stars" role="img" aria-label={`${r.stars} van 5 sterren`}>{[1, 2, 3, 4, 5].map(i => <svg class="i" aria-hidden="true" style={`opacity:${i <= r.stars ? 1 : 0.25}`}><use href="#i-star" /></svg>)}</span>{r.text && <p>{r.text}</p>}<small>{r.name} · bezocht in {MONTHS[+r.month.slice(5) - 1]} {r.month.slice(0, 4)}</small></div>)}
        <p class="pl-src">Reviews komen online na controle. <a href="/hoe-we-controleren#reviews">Hoe we reviews controleren</a></p></>
        : <p>Nog geen reviews. Ben je er geweest? <a href={kaart} rel="nofollow">Schrijf de eerste</a>; we zetten hem erop na controle.</p>}
    </section>
  </div>

  {photos.length > 0 && <section><h2 class="pl-h">Foto's van {p.name}</h2><div class="photos" style="grid-template-rows:120px 120px">{photos.slice(0, 3).map(f => <div><img src={f.url} alt={f.caption ?? `Foto van ${f.name}`} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" /></div>)}</div></section>}

  {sat.length >= 2 ? <section aria-labelledby="h-buurt">
      <h2 class="pl-h" id="h-buurt">Op loopafstand en zaterdag open</h2>
      <ul class="rows">{sat.map(o => <ItemRow it={o} note={`za ${ivTxt(satOf(o))} · ${kmTxt(km(p, o))}`} />)}</ul>
      <a class="pl-more" href={kaart}>Alle winkels rond {p.name} op de kaart</a></section>
    : others.length > 0 && <section aria-labelledby="h-buurt">
      <h2 class="pl-h" id="h-buurt">Tweedehands rond {p.name}</h2>
      <ul class="rows">{others.slice(0, 6).map(o => <ItemRow it={o} note={`${o.place ?? ''} · ${kmTxt(km(p, o))}`} />)}</ul>
      <a class="pl-more" href={kaart}>Alles in de buurt op de kaart</a></section>}

  {mk.length > 0 && <section aria-labelledby="h-markt">
    <h2 class="pl-h" id="h-markt">Markten in de buurt{p.place ? ` van ${p.place}` : ''}</h2>
    <table class="pl-dates"><tbody>{mk.map(m => <tr><th scope="row">{fmtDate(m.date)}</th><td><a href={ix.url(m.id)}>{m.name}</a><span class="hide-m">{m.venue ? `, ${niceVenue(m.venue)}` : ''}</span></td><td class="r">{kmTxt(km(p, m))}</td></tr>)}</tbody></table>
  </section>}

  <section class="pl-owner">
    <p>Is dit jouw winkel? {p.h ? 'Kloppen de tijden niet, pas ze dan zelf aan.' : 'Zet je openingstijden erop, dan zien snuffelaars wanneer je open bent.'} We zetten het erop na een korte controle.</p>
    <a href={`${kaart}&tijden=1`} rel="nofollow">Gegevens doorgeven</a>
  </section>
  <p class="pl-src">{p.src === 'osm' ? <>Gegevens: © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap-bijdragers</a> (ODbL). Zelf aanpassen kan op <a href={osmUrl!}>OpenStreetMap</a>.</> : <>Gegevens: © Overture Maps Foundation (CDLA Permissive 2.0).</>} Klopt er iets niet? Open de winkel in de app en tik op <b>Klopt er iets niet?</b></p>
  <PlekDock href={kaart} label="Bekijk op de kaart" />
</Tekst>
