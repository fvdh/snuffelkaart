---
// Winkelpagina: statisch, met de openingstijden van een gewone week en de bron. "Nu open" en het dagplan zitten in de app.
import Tekst from '../../layouts/Tekst.astro';
import ItemRow from '../../components/ItemRow.astro';
import type { Place } from '../../lib/model';
import { catOf, km, dLong } from '../../lib/model';
import { near, thin, weekHours, weekIntervals, hoursSpec, hoursSummary } from '../../lib/seo';
import { CAT } from '../../components/ui';
import { ix, places, markets, from, holidays, extra, SITE } from '../../lib/sitedata';
import { avg } from '../../lib/bijdragen';
import { DAY_CATS } from '../../lib/plan';

export function getStaticPaths() {
  return [...ix.shops].map(([slug, p]) => ({ params: { slug }, props: { p } }));
}
const { p } = Astro.props as { p: Place };
const cat = CAT[catOf(p)][0], week = weekHours(p.h, from, holidays), wk = weekIntervals(p.h, from, holidays), cityUrl = ix.cityUrl(p.place);
const web = p.website ? (p.website.startsWith('http') ? p.website : `https://${p.website}`) : null;
const osm = /^osm-([nwr])(\d+)$/.exec(p.id), osmUrl = osm ? `https://www.openstreetmap.org/${{ n: 'node', w: 'way', r: 'relation' }[osm[1] as 'n' | 'w' | 'r']}/${osm[2]}` : null;
const mk = near(p, markets, from, 10, 4);
const route = `https://www.google.com/maps/dir/?api=1&destination=${p.lat.toFixed(5)},${p.lon.toFixed(5)}`; // iPhone opent dit ook netjes
const checked = p.checked ? dLong(p.checked).toLowerCase() : null;
// Geen sloop, opkoop of pandjeshuis bij "meer tweedehands"; dichtstbij eerst.
const others = places.filter(o => o !== p && km(p, o) < 5 && DAY_CATS.includes(catOf(o))).sort((a, b) => km(p, a) - km(p, b)).slice(0, 6);
const reviews = extra.reviews[p.id] ?? [], photos = extra.photos[p.id] ?? [], rating = avg(reviews);
const MONTHS = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
const title = `${p.name}${p.place ? `, ${p.place}` : ''}`;
// Met tijden: die staan zo in het zoekresultaat ("kringloop open zondag"); zonder: adres en markten in de buurt.
const description = wk ? `${cat}${p.place ? ` in ${p.place}` : ''}, open ${hoursSummary(wk)}.${p.addr ? ` ${p.addr}.` : ''}` : `${cat}${p.place ? ` in ${p.place}` : ''}: adres${p.addr ? `, ${p.addr}` : ''}, en markten in de buurt.`;
const ld = { '@context': 'https://schema.org', '@type': 'Store', name: p.name, url: SITE + ix.url(p.id), geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lon },
  ...(p.addr ? { address: { '@type': 'PostalAddress', streetAddress: p.addr, addressLocality: p.place ?? undefined, addressCountry: 'NL' } } : {}), ...(p.phone ? { telephone: p.phone } : {}), ...(web ? { sameAs: web } : {}), ...(wk ? { openingHoursSpecification: hoursSpec(wk) } : {}),
  ...(reviews.length ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating, reviewCount: reviews.length, bestRating: 5, worstRating: 1 } } : {}),
  ...(photos.length ? { image: photos.slice(0, 3).map(f => f.url) } : {}) };
---
<Tekst title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  {thin(p) && <meta name="robots" content="noindex, follow" slot="head" />}
  <p class="tp-crumbs"><a href="/">Snuffelkaart</a> › {cityUrl ? <a href={cityUrl}>{p.place}</a> : (p.place ?? 'Winkel')}</p>
  <p class="eyebrow" style="margin-top:12px"><span class={`tile k c-${catOf(p)}`} style="width:24px;height:24px"><svg class="i" aria-hidden="true" style="width:14px;height:14px"><use href={`#i-${CAT[catOf(p)][2]}`} /></svg></span>{cat}</p>
  <h1>{p.name}</h1>
  <p class="lede"><a href={route} rel="nofollow" style="font-weight:inherit;color:inherit">{p.addr ?? p.place ?? ''}</a></p>
  {/* Wie via Google komt, wil vooral weten: is hij nu open? Uitgerekend in de browser uit de tijden van de komende twee weken. */}
  {p.h && <p class="tp-now" id="nu" data-from={from} data-h={JSON.stringify(p.h.slice(0, 14))} hidden></p>}
  {p.kind === 'tweedehands' && <p>Geen standaard kringloop: tweedehands, maar prijzen en aanbod kunnen anders zijn dan bij een kringloop.</p>}
  <div class="tp-cta"><b>Zet hem in je dagplan</b><p>Plan hem samen met andere kringlopen en markten. We rekenen uit wanneer je waar bent en of alles dan open is.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn primary" href={`/?open=${encodeURIComponent(p.id)}&plan=1`}>Plan in Mijn dag</a><a class="btn" href={route} rel="nofollow">Route</a>{p.phone && <a class="btn" href={`tel:${p.phone.split(';')[0].replace(/\s/g, '')}`}>Bel</a>}</div></div>

  <section>
    <h2>Openingstijden</h2>
    {week ? <><dl class="tp-hours">{week.map(d => <><dt data-dag={d.day}>{d.day}</dt><dd data-dag={d.day}>{d.txt}</dd></>)}</dl>
      <p style="font-size:.875rem;color:var(--fg-3)">{p.hs === 'bezoeker' ? `Doorgegeven door ${p.hb} en door ons gecontroleerd` : p.hs === 'web' ? <>Van <a href={p.hu}>de website van de winkel</a></> : `Bron: ${p.src === 'osm' ? 'OpenStreetMap' : 'Overture Maps'}`}{checked ? `, gecontroleerd op ${checked}` : ''}. Rond feestdagen kunnen de tijden afwijken.</p></>
      : <p>We weten de openingstijden nog niet. {p.src === 'osm' ? 'Deze winkel staat op OpenStreetMap, maar zonder tijden.' : 'Deze winkel komt uit Overture Maps en is nog niet door ons gecontroleerd; misschien bestaat hij niet meer.'} Bel even of kijk op de website voordat je gaat.</p>}
  </section>

  {(p.phone || web) && <section>
    <h2>Contact</h2>
    <ul class="tp-links" style="flex-direction:column">{p.phone && <li>Telefoon: <a href={`tel:${p.phone.replace(/\s/g, '')}`}>{p.phone}</a></li>}{web && <li>Website: <a href={web} rel="nofollow">{p.website!.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>}</ul>
  </section>}

  {photos.length > 0 && <section><h2>Foto's</h2><div class="photos" style="grid-template-rows:120px 120px">{photos.slice(0, 3).map(f => <div><img src={f.url} alt={f.caption ?? `Foto van ${f.name}`} loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block" /></div>)}</div></section>}
  {reviews.length > 0 && <section><h2>Reviews · {String(rating).replace('.', ',')} van 5 ({reviews.length})</h2>
    {reviews.map(r => <div class="rev"><span class="stars" role="img" aria-label={`${r.stars} van 5 sterren`}>{[1, 2, 3, 4, 5].map(i => <svg class="i" aria-hidden="true" style={`opacity:${i <= r.stars ? 1 : 0.25}`}><use href="#i-star" /></svg>)}</span>{r.text && <p>{r.text}</p>}<small>{r.name} · bezocht in {MONTHS[+r.month.slice(5) - 1]} {r.month.slice(0, 4)}</small></div>)}
    <p style="font-size:.875rem;color:var(--fg-3)">Reviews komen online na controle. <a href="/hoe-we-controleren#reviews">Hoe we reviews controleren</a></p></section>}
  {mk.length > 0 && <section><h2>Markten in de buurt</h2><ul class="rows">{mk.map(m => <ItemRow it={m} note={`${m.place} · ${Math.round(km(p, m))} km`} />)}</ul></section>}
  {others.length > 0 && <section><h2>Meer tweedehands in de buurt</h2><ul class="rows">{others.map(o => <ItemRow it={o} note={`${o.place ?? ''} · ${km(p, o).toFixed(1).replace('.', ',')} km`} />)}</ul></section>}

  <section>
    <p style="font-size:.875rem;color:var(--fg-3)">{p.src === 'osm' ? <>Gegevens: © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap-bijdragers</a> (ODbL). Zelf aanpassen kan op <a href={osmUrl!}>OpenStreetMap</a>.</> : <>Gegevens: © Overture Maps Foundation (CDLA Permissive 2.0). Nog niet door ons gecontroleerd.</>}</p>
    <p><a class="btn" href={`/?open=${encodeURIComponent(p.id)}`}>Review, foto of tijden doorgeven</a></p>
    <p style="font-size:.875rem;color:var(--fg-3)">Klopt er iets niet? Open de winkel in de app en tik onderaan op <b>Klopt er iets niet?</b>.</p>
  </section>
  <script is:inline>
    (() => {
      const el = document.getElementById('nu'); if (!el) return;
      const h = JSON.parse(el.dataset.h), [y, m, d] = el.dataset.from.split('-').map(Number), now = new Date();
      const i0 = Math.round((new Date(now.getFullYear(), now.getMonth(), now.getDate()) - new Date(y, m - 1, d)) / 864e5), min = now.getHours() * 60 + now.getMinutes();
      const hm = x => `${Math.floor(x / 60) % 24}:${String(x % 60).padStart(2, '0')}`, DAG = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
      const iv = h[i0]; if (!iv) return;
      const cur = iv.find(([a, b]) => min >= a && min < b), later = iv.find(([a]) => a > min);
      let txt, cls = 'closed';
      if (cur) { txt = `Nu open · sluit ${hm(cur[1])}`; cls = 'open'; }
      else if (later) txt = `Nu dicht · opent vandaag om ${hm(later[0])}`;
      else { for (let k = 1; k < 8 && h[i0 + k]; k++) if (h[i0 + k].length) { const w = new Date(now); w.setDate(w.getDate() + k); txt = `Nu dicht · opent ${k === 1 ? 'morgen' : DAG[w.getDay()]} om ${hm(h[i0 + k][0][0])}`; break; } }
      document.querySelectorAll(`[data-dag="${DAG[now.getDay()][0].toUpperCase() + DAG[now.getDay()].slice(1)}"]`).forEach(e => e.classList.add('vandaag'));
      if (!txt) return;
      el.textContent = txt; el.className = `tp-now ${cls}`; el.hidden = false;
    })();
  </script>
</Tekst>
