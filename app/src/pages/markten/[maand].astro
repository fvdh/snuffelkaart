---
// Markten per maand (24 nov): "rommelmarkt december", "vlooienmarkt januari". Vast adres per maand, steeds de eerstvolgende; per provincie zoals dit weekend.
import Tekst from '../../layouts/Tekst.astro';
import ItemRow from '../../components/ItemRow.astro';
import { PROVINCES, monthPages } from '../../lib/seo';
import { ix, markets, from, prov, SITE } from '../../lib/sitedata';

export function getStaticPaths() {
  return monthPages(markets, from).map(m => ({ params: { maand: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: ReturnType<typeof monthPages>[number] };
const all = monthPages(markets, from);
const ms = [...m.ms].sort((a, b) => a.date.localeCompare(b.date) || a.start - b.start || a.name.localeCompare(b.name));
const groups = PROVINCES.map(p => ({ p, ms: ms.filter(x => prov[x.place] === p.pdok) })).filter(g => g.ms.length);
const rest = ms.filter(x => !PROVINCES.some(p => p.pdok === prov[x.place]));
const when = `${m.name} ${m.year}`;
const title = `Rommelmarkten en vlooienmarkten in ${when}`;
const description = ms.length
  ? `${ms.length} rommelmarkten, vlooienmarkten en snuffelmarkten in ${when} in ${new Set(ms.map(x => x.place)).size} plaatsen, per provincie, met datum, tijden, entree en of ze doorgaan.`
  : `In ${when} staan er nog geen rommel- of vlooienmarkten in onze agenda. Organisatoren zetten hun data vaak pas later online.`;
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', name: title, itemListElement: ms.slice(0, 50).map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + ix.url(x.id), name: x.name })) };
---
<Tekst title={title} description={description} wide mail>
  {m.thin && <meta name="robots" content="noindex, follow" slot="head" />}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <p class="tp-crumbs"><a href="/">Snuffelkaart</a> › <a href="/markten/">Markten</a> › {m.name[0].toUpperCase() + m.name.slice(1)}</p>
  <h1>{title}</h1>
  <p class="lede">{description} {groups.length > 1 && <>Spring naar {groups.map((g, i) => <>{i ? ', ' : ''}<a href={`#${g.p.slug}`}>{g.p.name}</a></>)}.</>}</p>
  {groups.map(g => <section id={g.p.slug}>
    <h2>{g.p.name} <span style="color:var(--fg-3);font-weight:500">{g.ms.length}</span></h2>
    <ul class="rows">{g.ms.map(x => <ItemRow it={x} />)}</ul>
  </section>)}
  {rest.length > 0 && <section><h2>Overig</h2><ul class="rows">{rest.map(x => <ItemRow it={x} />)}</ul></section>}
  {!ms.length && <p>Kijk bij <a href="/markten/">alle markten</a> wat er de komende weken is.</p>}
  <section>
    <h2>Andere maanden</h2>
    <ul class="tp-links">{all.filter(x => x !== m).sort((a, b) => a.ym.localeCompare(b.ym)).map(x => <li><a href={`/markten/${x.slug}/`}>{x.name} {x.year}</a> <span style="color:var(--fg-3)">{x.ms.length}</span></li>)}</ul>
  </section>
</Tekst>
