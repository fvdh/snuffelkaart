---
// Organisatorpagina: alle markten van één organisator, met een badge die hij op zijn eigen site kan zetten (links terug = vindbaarheid).
import Tekst from '../../layouts/Tekst.astro';
import MarktAgenda from '../../components/MarktAgenda.astro';
import KaartBlok from '../../components/KaartBlok.astro';
import type { Market } from '../../lib/model';
import { dShort, hm } from '../../lib/model';
import { ix, SITE } from '../../lib/sitedata';

export function getStaticPaths() {
  return [...ix.orgs].map(([slug, o]) => ({ params: { slug }, props: { slug, name: o.name, markets: o.markets } }));
}
const { slug, name, markets } = Astro.props as { slug: string; name: string; markets: Market[] };
const ms = [...markets].sort((a, b) => a.date.localeCompare(b.date) || a.start - b.start);
const site = (() => { try { return new URL(ms.find(m => m.url)?.url ?? '').origin; } catch { return null; } })();
const places = [...new Set(ms.map(m => m.place))];
// Zoekers typen "vlooienmarkt van aerle", "vac rommelmarkt": de eerstvolgende markt in het zoekresultaat is de reden om te klikken.
const years = [...new Set([ms[0]?.date.slice(0, 4), ms.at(-1)?.date.slice(0, 4)])].filter(Boolean).join('–');
const next = ms[0], when = (m: Market) => `${dShort(m.date).toLowerCase()}${m.timeKnown !== false ? `, ${hm(m.start)}${m.end ? `–${hm(m.end)}` : ''}` : ''}`;
const title = `Markten van ${name} ${years}: data, tijden en entree`;
const h1 = `Markten van ${name}`;
const description = `${next ? `Volgende: ${next.name}, ${when(next)}. ` : ''}${ms.length} ${ms.length === 1 ? 'markt' : 'markten'} in ${places.slice(0, 4).join(', ')}${places.length > 4 ? ` en nog ${places.length - 4} plaatsen` : ''}, met tijden en entree. Elke nacht gecontroleerd.`;
const url = `${SITE}/organisator/${slug}/`;
const snippet = `<a href="${url}?via=badge"><img src="${SITE}/badge.svg" alt="Onze markten staan op Snuffelkaart" width="200" height="48"></a>`;
const ld = { '@context': 'https://schema.org', '@type': 'Organization', name, ...(site ? { url: site } : {}),
  event: ms.slice(0, 50).map(m => ({ '@type': 'Event', name: m.name, url: SITE + ix.url(m.id), startDate: m.date, location: { '@type': 'Place', name: m.venue ?? m.place, address: m.addr ?? m.place } })) };
---
<Tekst title={title} description={description} tel={`org:${slug}`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <p class="tp-crumbs"><a href="/">Snuffelkaart</a> › <a href="/markten/">Markten</a> › {name}</p>
  <h1>{h1}</h1>
  <p class="lede">{description}</p>
  <KaartBlok items={ms} href={`/?org=${slug}`} label={`Bekijk ${ms.length === 1 ? 'de markt' : `alle ${ms.length} markten`} op de kaart`} />
  <MarktAgenda markets={ms} empty={`Dit weekend geen markt van ${name}.`} />
  {site && <section>
    <h2>Over {name}</h2>
    <p>Meer informatie en kramen huren: <a href={site} rel="nofollow">{site.replace(/^https?:\/\/(www\.)?/, '')}</a>.</p>
  </section>}
  <section>
    <h2>Organiseer je deze markten?</h2>
    <p>We lezen je agenda elke nacht, dus nieuwe data en afgelastingen staan er vanzelf op. Zet deze badge op je site, dan vinden bezoekers je markten ook op de kaart, samen met de kringlopen in de buurt.</p>
    <p><img src="/badge.svg" alt="Onze markten staan op Snuffelkaart" width="200" height="48" /></p>
    <label for="badge-code" style="font-weight:600">Code om te plakken</label>
    <textarea id="badge-code" class="textarea" readonly rows="3" style="width:100%;font-family:ui-monospace,monospace;font-size:.8125rem" onclick="this.select()">{snippet}</textarea>
    <p style="font-size:.875rem;color:var(--fg-3)">Klopt er iets niet, of wil je liever niet op Snuffelkaart? Mail <a href="mailto:info@freekvanderhorst.com">info@freekvanderhorst.com</a>.</p>
  </section>
</Tekst>
