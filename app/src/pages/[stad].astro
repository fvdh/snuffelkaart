---
// Stadspagina (ontwerp §08): "Kringlopen en rommelmarkten in <plaats>", statisch, elke nacht opnieuw gebouwd.
import Tekst from '../layouts/Tekst.astro';
import ItemRow from '../components/ItemRow.astro';
import type { City } from '../lib/seo';
import { near } from '../lib/seo';
import { km, dLong, catOf, weekendOf, dayStart, hm } from '../lib/model';
import { DAY_CATS } from '../lib/plan';
import { ix, markets, from, generated, SITE } from '../lib/sitedata';

export function getStaticPaths() {
  return ix.cities.map(city => ({ params: { stad: city.slug }, props: { city } }));
}
const { city } = Astro.props as { city: City };
const kring = city.shops.filter(p => catOf(p) === 'kringloop').length;
const around = near(city, markets, from, 15, 10);
const [sat, sun] = weekendOf(dayStart(from));
const idx = (iso: string) => Math.round((dayStart(iso).getTime() - dayStart(from).getTime()) / 864e5);
const openOn = (iso: string) => city.shops.filter(p => p.h?.[idx(iso)]?.length);
const satOpen = openOn(sat), sunOpen = openOn(sun);
const hours = (p: (typeof city.shops)[number], iso: string) => p.h![idx(iso)].map(([a, b]) => `${hm(a)}–${hm(b % 1440)}`).join(', ');
// Kringlopen e.d. met bekende tijden eerst; sloop, opkoop en "tijden onbekend" onderaan (UX-test 30 okt: niet bovenaan een autodemontagebedrijf).
const rank = (p: (typeof city.shops)[number]) => (DAY_CATS.includes(catOf(p)) ? 0 : 2) + (p.h ? 0 : 1);
const shops = [...city.shops].sort((a, b) => rank(a) - rank(b) || a.name.localeCompare(b.name));
const weekendDay = (iso: string, open: typeof satOpen) => ({ iso, open: open.filter(p => DAY_CATS.includes(catOf(p))) });
const others = ix.cities.filter(c => c !== city).map(c => ({ c, d: km(city, c) })).sort((a, b) => a.d - b.d).slice(0, 8);
const updated = dLong(generated.slice(0, 10)).toLowerCase();
const parts = [city.shops.length && `${city.shops.length} ${city.shops.length === 1 ? 'tweedehandswinkel' : 'tweedehandswinkels'}${kring ? ` (waarvan ${kring} ${kring === 1 ? 'kringloop' : 'kringlopen'})` : ''}`, around.length && `${around.length} ${around.length === 1 ? 'markt' : 'markten'} in de buurt`].filter(Boolean);
const title = `Kringlopen en rommelmarkten in ${city.name}`;
const description = `${parts.join(' en ')} in ${city.name}, met openingstijden en de markten van de komende weken. Bijgewerkt op ${updated}.`;
const list = (xs: { name: string }[]) => xs.length <= 3 ? xs.map(x => x.name).join(', ').replace(/, ([^,]*)$/, ' en $1') : `${xs.slice(0, 3).map(x => x.name).join(', ')} en nog ${xs.length - 3}`;
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', name: title, itemListElement: [...city.shops, ...around].slice(0, 50).map((it, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + ix.url(it.id), name: it.name })) };
---
<Tekst title={title} description={description} wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <p class="tp-crumbs"><a href="/">Snuffelkaart</a> › <a href="/plaatsen/">Plaatsen</a> › {city.name}</p>
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <div class="tp-cta"><b>Plan je snuffeldag</b><p>Kies stops op de kaart. Snuffelkaart zet ze in de slimste volgorde en kijkt of alles open is als je er bent.</p>
    <a class="btn primary" href={`/?plek=${encodeURIComponent(city.name)}&lat=${city.lat.toFixed(5)}&lon=${city.lon.toFixed(5)}`}>Open de kaart rond {city.name}</a></div>

  {(satOpen.length > 0 || sunOpen.length > 0) && <section>
    <h2>Open dit weekend</h2>
    <div class="tp-weekend">{[weekendDay(sat, satOpen), weekendDay(sun, sunOpen)].map(({ iso, open }) => <div>
      <h3>{dLong(iso)}</h3>
      {open.length ? <ul class="tp-links" style="flex-direction:column">{open.map(p => <li><a href={ix.url(p.id)}>{p.name}</a> <span style="color:var(--fg-3)">{hours(p, iso)}</span></li>)}</ul> : <p>Geen kringloop open waarvan we de tijden kennen.</p>}
    </div>)}</div>
  </section>}

  {around.length > 0 && <section>
    <h2>Markten de komende weken</h2>
    <ul class="rows">{around.map(m => <ItemRow it={m} note={m.place === city.name ? undefined : `${m.venue ? `${m.venue}, ` : ''}${m.place} · ${Math.round(km(city, m))} km`} />)}</ul>
  </section>}

  {city.shops.length > 0 && <section>
    <h2>Tweedehandswinkels in {city.name}</h2>
    <ul class="rows">{shops.map(p => <ItemRow it={p} />)}</ul>
  </section>}

  {city.shops.some(p => p.h) && <section>
    <h2>Veelgestelde vragen</h2>
    <p><b>Welke kringloop of tweedehandswinkel in {city.name} is op zondag open?</b><br />{sunOpen.length ? `Op zondag ${dLong(sun).replace(/^Zondag /, '')} zijn open: ${list(sunOpen)}.` : `Op zondag ${dLong(sun).replace(/^Zondag /, '')} is geen enkele winkel in ${city.name} open waarvan we de tijden kennen.`}</p>
    <p><b>Welke winkels zijn op zaterdag open?</b><br />{satOpen.length ? `Op zaterdag ${dLong(sat).replace(/^Zaterdag /, '')}: ${list(satOpen)}.` : `Op zaterdag ${dLong(sat).replace(/^Zaterdag /, '')} is geen winkel open waarvan we de tijden kennen.`}</p>
    <p style="font-size:.875rem;color:var(--fg-3)">Van {city.shops.filter(p => !p.h).length} van de {city.shops.length} winkels weten we de tijden niet; bel die even.</p>
  </section>}

  <section>
    <h2>In de buurt</h2>
    <ul class="tp-links">{others.map(({ c, d }) => <li><a href={`/${c.slug}/`}>{c.name}</a> <span style="color:var(--fg-3)">{Math.round(d)} km</span></li>)}</ul>
  </section>
</Tekst>
