---
// Stadspagina (ontwerp "deurbordje", 9 nov): wie "kringloop <plaats>" googlet, ziet bovenaan als tekst hoeveel er nu open zijn en
// wat er zaterdag en zondag open is; daaronder de kaart en per groep een tabel met de tijden van vandaag. Tijden staan als tekst in de
// HTML (de dag van de build); PlekDock maakt er "vandaag" en "nu open" van.
import Tekst from '../layouts/Tekst.astro';
import KaartBlok from '../components/KaartBlok.astro';
import PlekDock from '../components/PlekDock.astro';
import '../styles/plek.css';
import type { City } from '../lib/seo';
import type { Place } from '../lib/model';
import { near, cityThin, niceVenue, splitAddr, PROVINCES } from '../lib/seo';
import { km, dLong, catOf, weekendOf, dayStart, hm } from '../lib/model';
import { ix, markets, from, generated, prov, SITE } from '../lib/sitedata';

export function getStaticPaths() {
  return ix.cities.map(city => ({ params: { stad: city.slug }, props: { city } }));
}
const { city } = Astro.props as { city: City };
const name = city.name, url = `/${city.slug}/`;
const province = PROVINCES.find(p => p.pdok === prov[name]);
const kaart = `/kaart/?plek=${encodeURIComponent(name)}&lat=${city.lat.toFixed(5)}&lon=${city.lon.toFixed(5)}`;
// Groepen: kringlopen (ook goede doelen), dan vintage/antiek/overig tweedehands, dan sloop en opkoop (zonder tijden-tabel).
const rank = (p: Place) => (p.h ? 0 : 1);
const byRank = (xs: Place[]) => xs.sort((a, b) => rank(a) - rank(b) || a.name.localeCompare(b.name, 'nl'));
const kring = byRank(city.shops.filter(p => catOf(p) === 'kringloop'));
const tweede = byRank(city.shops.filter(p => ['kleding', 'antiek', 'tweedehands', 'vlooienmarkt'].includes(catOf(p))));
const rest = city.shops.filter(p => ['schroot', 'pandjeshuis'].includes(catOf(p)));
const around = near(city, markets, from, 15, 10);
const [sat, sun] = weekendOf(dayStart(from));
const idx = (iso: string) => Math.round((dayStart(iso).getTime() - dayStart(from).getTime()) / 864e5);
const ivTxt = (iv: [number, number][]) => iv.map(([a, b]) => `${hm(a)}–${hm(b % 1440)}`).join(' en ');
const dayTxt = (p: Place, i: number) => (p.dicht ? 'tijdelijk gesloten' : p.afspraak ? 'op afspraak' : !p.h ? 'tijden onbekend' : p.h[i]?.length ? ivTxt(p.h[i]) : 'dicht');
// Zelfde naam twee keer ("Kringloop Zwolle" ×3): straat erbij (UX-test 30 okt).
const dup = new Set(city.shops.map(p => p.name).filter((n, i, a) => a.indexOf(n) !== i));
const label = (p: Place) => (dup.has(p.name) && p.addr ? `${p.name} (${p.addr.split(',')[0]})` : p.name);
const list = (xs: Place[]) => (xs.length <= 3 ? xs.map(label).join(', ').replace(/, ([^,]*)$/, ' en $1') : `${xs.slice(0, 3).map(label).join(', ')} en nog ${xs.length - 3}`);
const shopsOn = (iso: string, xs = [...kring, ...tweede]) => xs.filter(p => !p.dicht && p.h?.[idx(iso)]?.length);
const kSat = shopsOn(sat, kring), kSun = shopsOn(sun, kring), oSat = shopsOn(sat), oSun = shopsOn(sun);
const known = [...kring, ...tweede].filter(p => p.h).length;
const n = (x: number, one: string, more: string) => `${x} ${x === 1 ? one : more}`;
const what = [kring.length && n(kring.length, 'kringloop', 'kringlopen'), tweede.length && n(tweede.length, 'andere tweedehandswinkel', 'andere tweedehandswinkels')].filter(Boolean).join(' en ');
const updated = dLong(generated.slice(0, 10)).toLowerCase();
const title = kring.length > 1 ? `Kringloop ${name}: ${kring.length} kringlopen met openingstijden` : kring.length ? `Kringloop ${name}: openingstijden, tweedehands en markten` : `Tweedehands in ${name}: winkels, tijden en markten`;
const description = `${kring.length ? `Welke kringloop in ${name} is nu open? ` : ''}${what || 'Tweedehands'} in ${name} met de tijden van vandaag${around.length ? `, plus ${n(around.length, 'markt', 'markten')} in de buurt` : ''}. Bijgewerkt op ${updated}.`;
const satTxt = (ks: Place[], all: Place[]) => (ks.length ? list(ks) : all.length ? `geen kringloop, wel ${list(all)}` : kring.length ? 'geen kringloop waarvan we de tijden kennen' : 'niets waarvan we de tijden kennen');
const others = ix.cities.filter(c => c !== city).map(c => ({ c, d: km(city, c) })).sort((a, b) => a.d - b.d).slice(0, 10);
const kmTxt = (k: number) => `${Math.round(k)} km`;
const dateOf = (iso: string) => `${dLong(iso)}${iso.slice(0, 4) !== from.slice(0, 4) ? ` ${iso.slice(0, 4)}` : ''}`;
// Dun: minder dan twee winkels of markten die meer zeggen dan "bestaat misschien niet meer" (zie thin()). Wel op de kaart, niet in Google.
const isThin = cityThin(city, markets, from);
const crumbs: [string, string][] = [['Snuffelkaart', '/'], ['Plaatsen', '/plaatsen/'], ...(province ? [[province.name, `/provincie/${province.slug}/`] as [string, string]] : []), [name, url]];
const ld = { '@context': 'https://schema.org', '@type': 'ItemList', name: title, itemListElement: [...kring, ...tweede, ...around].slice(0, 50).map((it, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + ix.url(it.id), name: it.name })) };
const crumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map(([c, u], i) => ({ '@type': 'ListItem', position: i + 1, name: c, item: SITE + u })) };
const dayHead = dLong(from);
---
<Tekst title={title} description={description} wide tel={`stad:${city.slug}`} mail={name}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbLd)} />
  {isThin && <meta name="robots" content="noindex, follow" slot="head" />}
  <nav aria-label="Kruimelpad"><ol class="pl-crumbs">{crumbs.map(([c, u], i) => i < crumbs.length - 1 ? <li><a href={u}>{c}</a></li> : <li aria-current="page">{c}</li>)}</ol></nav>

  <div class="pl-sign">
    <h1>{kring.length ? `Kringlopen in ${name}` : `Tweedehands in ${name}`}</h1>
    <p class="pl-what"><span class="pl-shape" aria-hidden="true"></span>{what ? `${what[0].toUpperCase()}${what.slice(1)}` : 'Tweedehands'}{around.length > 0 && `, ${n(around.length, 'markt', 'markten')} in de buurt`}</p>
    <div class="pl-door">
      {known > 0 && <p class="pl-now" id="pl-stad-nu" data-kring={kring.length ? '1' : ''} hidden></p>}
      {(oSat.length > 0 || oSun.length > 0) ? <>
        <p class="pl-week pl-wk"><b>{dLong(sat)} open:</b> {satTxt(kSat, oSat)}</p>
        <p class="pl-week pl-wk"><b>{dLong(sun)} open:</b> {satTxt(kSun, oSun)}{!kSun.length && <> · <a href="/kringloop-open-op-zondag/">kringlopen die op zondag open zijn</a></>}</p>
      </> : <p class="pl-week unk">Van de winkels in {name} kennen we de tijden <em>nog niet</em>. Bel even voordat je gaat.</p>}
    </div>
    <div class="pl-acts"><a class="btn primary" href={kaart}><svg class="i" aria-hidden="true"><use href="#i-map" /></svg>Bekijk op de kaart</a></div>
    <p class="pl-src">Tijden van de websites van de winkels, OpenStreetMap en bezoekers; elke nacht bijgewerkt, laatst op {updated}.{known < kring.length + tweede.length && ` Van ${kring.length + tweede.length - known} van de ${kring.length + tweede.length} winkels kennen we de tijden niet.`}</p>
  </div>

  <KaartBlok items={[...city.shops, ...around]} href={kaart} label={`Alles in en rond ${name} op de kaart`} />

  {[[kring, `Kringlopen in ${name}`, 'h-kring'], [tweede, kring.length ? `Vintage, antiek en tweedehands in ${name}` : `Tweedehandswinkels in ${name}`, 'h-tweede']].map(([xs, h, id]) => (xs as Place[]).length > 0 && <section aria-labelledby={id as string}>
    <h2 class="pl-h" id={id as string}>{h as string}</h2>
    <table class="pl-dates pl-stad" data-from={from}>
      <thead><tr><th scope="col"><span class="sr">Winkel</span></th><th scope="col" class="r pl-dag">{dayHead}</th></tr></thead>
      <tbody>{(xs as Place[]).map(p => <tr data-h={p.h && !p.dicht ? JSON.stringify(p.h.slice(0, 8)) : undefined}>
        <th scope="row"><a href={ix.url(p.id)}>{p.name}</a>{p.addr && <small>{splitAddr(p.addr, p.place).street}</small>}</th>
        <td class={`r${p.h && !p.dicht ? '' : ' unk'}`}>{dayTxt(p, 0)}</td>
      </tr>)}</tbody>
    </table>
  </section>)}

  {around.length > 0 && <section aria-labelledby="h-markt">
    <h2 class="pl-h" id="h-markt">Rommelmarkten in en rond {name}</h2>
    <table class="pl-dates"><tbody>{around.map(m => <tr>
      <th scope="row">{dateOf(m.date)}</th>
      <td><a href={ix.url(m.id)}>{m.name}</a><span class="hide-m">{m.venue ? `, ${niceVenue(m.venue)}` : ''}</span></td>
      <td class="r">{m.place === name ? name : `${m.place} · ${kmTxt(km(city, m))}`}</td>
    </tr>)}</tbody></table>
    <a class="pl-more" href="/rommelmarkt-dit-weekend/">Alle rommelmarkten dit weekend</a>
  </section>}

  {rest.length > 0 && <section aria-labelledby="h-rest">
    <h2 class="pl-h" id="h-rest">Sloop, opkoop en restpartijen</h2>
    <p class="pl-places">{rest.map(p => <><a href={ix.url(p.id)}>{label(p)}</a> </>)}</p>
  </section>}

  <section aria-labelledby="h-buurt">
    <h2 class="pl-h" id="h-buurt">Kringlopen in de buurt van {name}</h2>
    <p class="pl-places">{others.map(({ c, d }) => <><a href={`/${c.slug}/`}>{c.name}</a><small>{kmTxt(d)}</small> </>)}</p>
    {province && <p><a class="pl-more" href={`/provincie/${province.slug}/`}>Alle plaatsen in {province.name}</a></p>}
  </section>
  <PlekDock href={kaart} label="Bekijk op de kaart" />
</Tekst>
