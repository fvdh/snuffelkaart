// Preview op Cloudflare (account Freek): statische site uit dist/. worker/klok.js is alleen de klok (cron → GitHub-workflows).
// Uitrollen: elke nacht via .github/workflows/nachtelijk.yml, of met de hand: npm run build && npx wrangler deploy
{
  "name": "snuffelkaart",
  "account_id": "092890fe4cde8445e74991b7d7ae19fd", // geen geheim; het token staat als secret in GitHub
  "compatibility_date": "2026-10-27",
  "main": "worker/klok.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "triggers": { "crons": ["*/15 * * * *"] },
  // workers.dev-adres blijft ook werken (oude links, geïnstalleerde app); zonder deze regel zet wrangler het uit
  "workers_dev": true,
  "routes": [
    { "pattern": "snuffelkaart.nl", "custom_domain": true },
    { "pattern": "www.snuffelkaart.nl", "custom_domain": true }
  ]
}
